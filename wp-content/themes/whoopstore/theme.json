{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "background", "name": "Фон", "color": "#0f1217" },
				{ "slug": "surface", "name": "Поверхность (карточка)", "color": "#1b1e23" },
				{ "slug": "accent", "name": "Акцент", "color": "#02f1a0" },
				{ "slug": "accent-contrast", "name": "Текст на акценте", "color": "#252828" },
				{ "slug": "foreground", "name": "Текст", "color": "#ffffff" },
				{ "slug": "foreground-muted", "name": "Текст приглушённый", "color": "rgba(255,255,255,0.9)" },
				{ "slug": "foreground-faint", "name": "Текст (старая цена)", "color": "rgba(255,255,255,0.2)" },
				{ "slug": "surface-translucent", "name": "Поверхность полупрозрачная", "color": "rgba(255,255,255,0.1)" },
				{ "slug": "surface-faint", "name": "Поверхность (бейдж)", "color": "rgba(255,255,255,0.05)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "'Onest', system-ui, -apple-system, sans-serif",
					"slug": "onest",
					"name": "Onest",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/onest/onest-latin.woff2" ],
							"unicodeRange": "U+0000-00FF,U+2000-206F,U+20AC,U+2122"
						},
						{
							"fontFamily": "Onest",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/onest/onest-cyrillic.woff2" ],
							"unicodeRange": "U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "sm", "name": "Small (14)", "size": "14px" },
				{ "slug": "base", "name": "Base (16)", "size": "16px" },
				{ "slug": "md", "name": "Medium (20)", "size": "20px" },
				{ "slug": "lg", "name": "Large (22)", "size": "22px" },
				{ "slug": "xl", "name": "XL (35)", "size": "35px" },
				{ "slug": "hero", "name": "Hero (46)", "size": "46px" }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "16px" },
				{ "slug": "30", "name": "M", "size": "20px" },
				{ "slug": "40", "name": "L", "size": "30px" },
				{ "slug": "50", "name": "XL", "size": "40px" },
				{ "slug": "60", "name": "2XL", "size": "70px" }
			]
		},
		"custom": {
			"radius": {
				"button": "20px",
				"card": "20px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--onest)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.2"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--foreground)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--accent-contrast)",
					"background": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "500"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "24px",
						"right": "24px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.1"
				}
			}
		},
		"blocks": {
			"woocommerce/product-price": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground-muted)"
				}
			},
			"woocommerce/add-to-cart-form": {
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	]
}
