# Whoopstore — allowlist .gitignore
#
# По умолчанию ИГНОРИРУЕТСЯ ВСЁ в этой директории. Ниже — только явные
# исключения для файлов/директорий, которые относятся к нашей кастомной
# разработке. WordPress core, плагины (включая WooCommerce), uploads,
# кэши инструментов разработки и любые секреты/credentials никогда не
# должны попадать в репозиторий.

# 1) Игнорировать всё в корне по умолчанию.
/*

# 2) Разрешить сам .gitignore, проектные правила и служебные скрипты проверки.
!/.gitignore
!/CLAUDE.md
!/tools/

# 3) wp-content: открыть путь, закрыть содержимое по умолчанию.
!/wp-content/
/wp-content/*

# 4) Темы: открыть путь до themes, закрыть содержимое, разрешить только нашу тему.
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/whoopstore/

# 5) MU-plugins: открыть путь, закрыть содержимое, разрешить только наши mu-plugins.
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/whoopstore-staging-guard.php
!/wp-content/mu-plugins/whoopstore-commerce.php
!/wp-content/mu-plugins/whoopstore-commerce/
!/wp-content/mu-plugins/whoopstore-site.php
!/wp-content/mu-plugins/whoopstore-site/

# ---------------------------------------------------------------------
# Дополнительная защита: эти файлы/паттерны никогда не попадают в
# репозиторий, даже если случайно окажутся внутри разрешённого пути.
# ---------------------------------------------------------------------
wp-config.php
*.env
.env*
*.sql
*.sql.gz
*.log
.claude/
.claude.json
.bash_history
*.pem
id_rsa*
*credentials*

# Результат прогона tools/qa/smoke.php — временные HTML-дампы страниц.
/tools/qa/out/

# Локальные вспомогательные материалы для вёрстки (дампы/заметки Figma MCP).
# Хранятся только на диске стенда, в репозиторий не попадают.
/wp-content/themes/whoopstore/docs/figma-design/
/wp-content/themes/whoopstore/docs/figma-homepage-mobile-metadata.xml
